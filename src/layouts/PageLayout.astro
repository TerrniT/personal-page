---
import { Head, Header, Footer, Sidebar, Container, CookieConsent } from '@components/astro/layout'

import { SITE } from '@consts'

import { type Language, getLangFromUrl } from '@lib/i18n'

type Props = {
  title: string
  description: string
  author?: string
  image?: string
  lang?: Language
  isCustomTitle?: boolean
}

const { title, description, image, author, lang, isCustomTitle } = Astro.props

const htmlLang = lang ?? getLangFromUrl(Astro.url)
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <Head
      title={isCustomTitle ? title : `${title} | ${SITE.NAME}`}
      description={description}
      image={image}
      author={author}
    />
  </head>
  <body>
    <div class="relative flex min-h-screen w-full flex-col">
      <Header />

      <div class="flex w-full flex-1 flex-col md:flex-row">
        <Sidebar />

        <Container>
          <slot />
          <Footer />
        </Container>
      </div>
    </div>

    <CookieConsent />
  </body>
</html>
