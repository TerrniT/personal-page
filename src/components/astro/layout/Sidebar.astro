---
import { Navigation, SocialsLinks } from '@components/astro/layout'

import { ThemeSwitcher, LanguageSwitcher } from '@components/react/layout'

const { url } = Astro
---

<div class="sticky top-0 hidden h-screen w-[220px] shrink-0 flex-col justify-between px-4 py-6 md:top-16 md:flex md:h-[calc(100vh-4rem)]">
  <div>
    <Navigation />
    <SocialsLinks />
  </div>

  <div class="flex gap-x-1 px-2">
    <ThemeSwitcher client:load side={'right'} />
    <LanguageSwitcher client:load url={url} side={'right'} />
  </div>
</div>
