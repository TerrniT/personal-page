---
import { Link, BackToTop } from '@components/astro/layout'

import { SITE, SOCIALS } from '@consts'

import { useI18n } from '@lib/i18n'

import { Icon } from 'astro-icon/components'

const { url } = Astro
const { t, p } = useI18n(url)

const year = new Date().getFullYear()
---

<footer class="animate">
  <div class="mt-10 flex flex-col gap-4 border-t border-border/40 pt-6 md:mt-12">
    <div class="flex items-center justify-between gap-3">
      <div class="flex flex-col gap-1">
        <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground">KOTOVSKY</span>
        <span class="text-sm text-muted-foreground">&copy; {year} {SITE.NAME}</span>
      </div>
      <BackToTop />
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <Link href={p('/policy')} underline={false}>{t('footer.policy')}</Link>
      <Link href={p('/legal')} underline={false}>{t('footer.legal')}</Link>
      <button
        type="button"
        data-cookie-consent-open
        class="text-muted-foreground underline-offset-2 transition-colors duration-300 ease-in-out hover:text-secondary-foreground hover:underline"
      >
        {t('footer.cookies')}
      </button>
    </div>

    <div class="flex flex-wrap gap-3">
      {
        SOCIALS.map((link) => (
          <Link
            href={link.HREF}
            external
            underline={false}
            classes="flex items-center gap-x-2 text-muted-foreground underline-offset-2 transition-all duration-150 ease-linear hover:text-foreground hover:underline"
          >
            {link.ICON && <Icon name={link.ICON} size={'1.2em'} />}
            <span>{link.NAME}</span>
          </Link>
        ))
      }
    </div>
  </div>
</footer>
