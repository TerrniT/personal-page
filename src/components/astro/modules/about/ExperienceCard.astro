---
interface Props {
  experience: {
    job_title: string
    company_name: string
    live_url?: string
    duration: string
    location?: string
    icon?: string
    stack?: string[]
  }
}

const { experience } = Astro.props
const { job_title, company_name, live_url, duration, location, icon, stack } = experience
---

<li class="surface flex flex-col gap-3 p-4 md:flex-row md:items-start md:gap-5">
  <div class="flex min-w-0 items-center gap-3 md:w-[38%]">
    {
      icon && (
        <img
          src={icon}
          alt={company_name}
          width="32"
          height="32"
          loading="lazy"
          class="size-8 flex-none rounded-md border border-border/60 bg-main/40 object-contain p-1"
        />
      )
    }
    <div class="min-w-0">
      <div class="truncate font-semibold text-main-foreground">{job_title}</div>
      {
        live_url
          ? (
              <a
                href={live_url}
                target="_blank"
                rel="noopener noreferrer"
                class="truncate text-sm text-muted-foreground underline-offset-4 hover:text-main-foreground hover:underline"
              >
                {company_name}
              </a>
            )
          : (
              <span class="truncate text-sm text-muted-foreground">{company_name}</span>
            )
      }
    </div>
  </div>

  <div class="flex flex-1 flex-col gap-2 text-sm">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-muted-foreground">
      <span>{duration}</span>
      {location && <span class="text-muted-foreground/70">{location}</span>}
    </div>

    {
      stack && stack.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {stack.map(item => (
            <span class="rounded bg-muted-foreground/10 px-1.5 py-0.5 text-[11px] text-muted-foreground">{item}</span>
          ))}
        </div>
      )
    }
  </div>
</li>
