---
import { getLangFromUrl, getLangFromSlug, useI18n } from '@lib/i18n'
import { resolveSlug } from '@lib/mdx'
import { getSiteContent, type ArticleCategoryLabels } from '@data/site'

import { getCollection } from 'astro:content'

import PageLayout from '@layouts/PageLayout.astro'
import FormattedDate from '@components/astro/FormattedDate.astro'

const { url } = Astro
const { p } = useI18n(url)
const lang = getLangFromUrl(url)
const site = getSiteContent(lang)
const labels = site.articlesPage

type CategoryKey = keyof ArticleCategoryLabels

const categoryKeys: CategoryKey[] = ['development', 'ai-for-business', 'case-studies', 'guides']

const requestedCategory = url.searchParams.get('category') ?? 'all'
const activeCategory: CategoryKey | 'all' = categoryKeys.includes(requestedCategory as CategoryKey)
  ? (requestedCategory as CategoryKey)
  : 'all'

function buildCategoryHref(category: CategoryKey | 'all') {
  return category === 'all' ? p('/articles') : `${p('/articles')}?category=${category}`
}

const posts = (await getCollection('articles'))
  .filter(item => !item.data.draft)
  .filter(item => item.data.type !== 'note')
  .filter(item => getLangFromSlug(item.slug) === lang)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .map((item) => {
    const category = (item.data.category ?? 'development') as CategoryKey
    return {
      title: item.data.title,
      description: item.data.description,
      date: item.data.date,
      topic: item.data.topic,
      category,
      href: `/articles/${resolveSlug(item.slug)}`,
    }
  })
  .filter(item => activeCategory === 'all' || item.category === activeCategory)

const yearList = Object.entries(
  posts.reduce<Record<string, typeof posts>>((acc, item) => {
    const year = new Date(item.date).getFullYear()
    if (!acc[year])
      acc[year] = []
    acc[year].push(item)
    return acc
  }, {}),
).sort(([yearA], [yearB]) => +yearB - +yearA)

const meta = site.meta.articles
---

<PageLayout title={meta.title} description={meta.description}>
  <h1 class="animate text-xl font-semibold">{labels.title}</h1>

  <div class="space-y-8">
    <section class="animate space-y-3">
      <p class="max-w-2xl text-muted-foreground">{labels.description}</p>
    </section>

    <section class="animate space-y-3" aria-label={labels.categoriesTitle}>
      <div class="flex flex-wrap gap-2">
        <a
          href={buildCategoryHref('all')}
          class:list={['chip', activeCategory === 'all' && 'chip-active']}
          aria-current={activeCategory === 'all' ? 'page' : undefined}
        >
          {labels.categories.all}
        </a>
        {
          categoryKeys.map(category => (
            <a
              href={buildCategoryHref(category)}
              class:list={['chip', activeCategory === category && 'chip-active']}
              aria-current={activeCategory === category ? 'page' : undefined}
            >
              {labels.categories[category]}
            </a>
          ))
        }
      </div>
    </section>
  </div>

  {
    yearList.length > 0
      ? (
          <div data-animate data-animate-speed="slow" class="group mt-12 space-y-7 border-l border-border pl-4">
            {yearList.map(([year, postList], index) => (
              <div class="group/year relative">
                <div class="animate absolute -left-20 -mx-1 w-fit select-none rounded-md px-1 transition group-hover/year:bg-primary/5 group-hover/year:text-main-foreground group-hover/year:!opacity-100 group-hover:opacity-40 sm:relative sm:left-0 sm:mb-2">
                  <h3 class="text-primary-foreground">{year}</h3>
                </div>
                <ul data-animate data-animate-speed="fast" class="animate flex flex-col items-start gap-2">
                  {postList.map(post => (
                    <li style={`--start: ${index * 75}ms;`}>
                      <a
                        href={p(post.href)}
                        class="animate -mx-1 flex w-full flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-md px-1 transition hover:bg-selection hover:!opacity-100 group-hover:opacity-60"
                      >
                        <span class="text-main-foreground">{post.title}</span>
                        <span class="flex flex-none items-center gap-2 text-sm text-muted-foreground">
                          <span class="rounded bg-muted-foreground/10 px-1.5 py-0.5 text-xs">
                            {labels.categories[post.category]}
                          </span>
                          <FormattedDate date={post.date} short={true} />
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      : (
          <section class="animate mt-12 rounded-md border border-dashed border-border p-6">
            <h2 class="text-lg font-semibold text-main-foreground">{labels.emptyTitle}</h2>
            <p class="mt-2 text-sm text-muted-foreground">{labels.emptyDescription}</p>
            <a class="chip mt-4" href={p('/articles')}>{labels.categories.all}</a>
          </section>
        )
  }
</PageLayout>
