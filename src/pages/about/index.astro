---
import { getLangFromUrl, useI18n } from '@lib/i18n'
import { SITE, HARD_SKILLS, EXPERTISE } from '@consts'
import { getSiteContent } from '@data/site'

import { Icon } from 'astro-icon/components'

import { CtaBlock } from '@components/astro/modules/shared'

import PageLayout from '@layouts/PageLayout.astro'

const { url } = Astro
const { p } = useI18n(url)
const lang = getLangFromUrl(url)
const site = getSiteContent(lang)
const labels = site.aboutPage

type SkillItem = { name: string, icon: string, link?: string }
const skills = HARD_SKILLS as SkillItem[]
const expertise = EXPERTISE as SkillItem[]

const meta = site.meta.about
---

<PageLayout title={meta.title} description={meta.description}>
  <section class="animate max-w-2xl space-y-4">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">{labels.eyebrow}</p>
    <h1 class="text-xl font-semibold text-main-foreground md:text-2xl">{labels.title}</h1>
    <p class="text-base font-medium text-main-foreground">{labels.headline}</p>
    {
      labels.paragraphs.map(paragraph => (
        <p class="text-sm leading-6 text-muted-foreground">{paragraph}</p>
      ))
    }
    <div class="flex flex-wrap gap-2 pt-2">
      <a class="btn btn-primary" href={SITE.TELEGRAM} target="_blank" rel="noopener noreferrer">
        {labels.cta.telegram}
      </a>
      <a class="btn btn-outline" href={p('/hire')}>{labels.hireCta}</a>
    </div>
  </section>

  <section class="mt-16 space-y-5">
    <div class="animate space-y-1">
      <h2 class="font-semibold text-main-foreground">{labels.focusTitle}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        labels.focus.map(item => (
          <div class="animate surface flex flex-col gap-2 p-4">
            <h3 class="font-medium text-main-foreground">{item.title}</h3>
            <p class="text-sm text-muted-foreground">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 space-y-5">
    <div class="animate space-y-1">
      <h2 class="font-semibold text-main-foreground">{labels.skillsTitle}</h2>
      <p class="text-sm text-muted-foreground">{labels.skillsDescription}</p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {
        skills.map(item => (
          <div class="animate surface flex items-center gap-3 p-3">
            <Icon name={item.icon} size="1.5em" class="text-primary-foreground" />
            {item.link
              ? <a class="text-sm text-main-foreground underline-offset-4 hover:underline" href={item.link} target="_blank" rel="noopener noreferrer">{item.name}</a>
              : <span class="text-sm text-main-foreground">{item.name}</span>}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 space-y-5">
    <div class="animate space-y-1">
      <h2 class="font-semibold text-main-foreground">{labels.expertiseTitle}</h2>
      <p class="text-sm text-muted-foreground">{labels.expertiseDescription}</p>
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      {
        expertise.map(item => (
          <div class="animate surface flex items-center gap-3 p-3">
            <Icon name={item.icon} size="1.5em" class="text-primary-foreground" />
            <span class="text-sm text-main-foreground">{item.name}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 space-y-5">
    <div class="animate space-y-1">
      <h2 class="font-semibold text-main-foreground">{labels.howTitle}</h2>
      <p class="text-sm text-muted-foreground">{labels.howDescription}</p>
    </div>
    <ul class="flex flex-col gap-2">
      {
        labels.howPoints.map(point => (
          <li class="animate surface flex gap-2 p-3 text-sm text-muted-foreground">
            <span class="text-primary-foreground">•</span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="animate mt-16 flex flex-col gap-3 rounded-md border border-border bg-secondary/30 p-5 md:flex-row md:items-center md:justify-between">
    <div class="space-y-1">
      <h2 class="font-semibold text-main-foreground">{labels.hireTitle}</h2>
      <p class="text-sm text-muted-foreground">{labels.hireDescription}</p>
    </div>
    <a class="btn btn-outline w-fit" href={p('/hire')}>{labels.hireCta}</a>
  </section>

  <div class="mt-16">
    <CtaBlock
      title={labels.cta.title}
      description={labels.cta.description}
      primaryLabel={labels.cta.telegram}
      primaryHref={SITE.TELEGRAM}
      secondaryLabel={labels.cta.email}
      secondaryHref={`mailto:${SITE.EMAIL}`}
    />
  </div>
</PageLayout>
