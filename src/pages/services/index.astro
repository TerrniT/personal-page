---
import { useI18n, getLangFromUrl } from '@lib/i18n'
import { getServicesInfoList } from '@lib/mdx'
import { SITE } from '@consts'
import { getSiteContent } from '@data/site'

import { ServiceCard } from '@components/astro/modules/service'
import { CtaBlock } from '@components/astro/modules/shared'

import PageLayout from '@layouts/PageLayout.astro'

const { url } = Astro
const { p } = useI18n(url)
const lang = getLangFromUrl(url)
const site = getSiteContent(lang)
const labels = site.servicesPage

const services = await getServicesInfoList(lang)
const meta = site.meta.services
---

<PageLayout title={meta.title} description={meta.description}>
  <section class="animate max-w-2xl space-y-4">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">{labels.eyebrow}</p>
    <h1 class="text-xl font-semibold text-main-foreground md:text-2xl">{labels.title}</h1>
    <p class="text-muted-foreground">{labels.description}</p>
    <div class="flex flex-wrap gap-2 pt-2">
      <a class="btn btn-primary" href={SITE.TELEGRAM} target="_blank" rel="noopener noreferrer">
        {labels.cta.telegram}
      </a>
      <a class="btn btn-outline" href={`mailto:${SITE.EMAIL}`}>{labels.cta.email}</a>
    </div>
  </section>

  <section class="mt-14 space-y-5">
    <div class="animate space-y-1">
      <h2 class="font-semibold text-main-foreground">{labels.listTitle}</h2>
      <p class="text-sm text-muted-foreground">{labels.listDescription}</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        services.map(service => (
          <ServiceCard
            title={service.data.title}
            description={service.data.description}
            icon={service.data.icon}
            order={service.data.order}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-16 space-y-5">
    <div class="animate space-y-1">
      <h2 class="font-semibold text-main-foreground">{labels.faqTitle}</h2>
      <p class="text-sm text-muted-foreground">{labels.faqDescription}</p>
    </div>

    <div class="space-y-2">
      {
        labels.faq.map(item => (
          <details class="animate group rounded-md border border-border bg-secondary/20 px-4 py-3 open:bg-secondary/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-main-foreground">
              <span>{item.question}</span>
              <span class="text-muted-foreground transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <div class="mt-16">
    <CtaBlock
      title={labels.cta.title}
      description={labels.cta.description}
      primaryLabel={labels.cta.telegram}
      primaryHref={SITE.TELEGRAM}
      secondaryLabel={labels.cta.email}
      secondaryHref={`mailto:${SITE.EMAIL}`}
    />
  </div>

  <p class="mt-6 text-xs text-muted-foreground/60">
    <a href={p('/cases')} class="underline underline-offset-2 hover:text-main-foreground">{site.home.cases.link}</a>
  </p>
</PageLayout>
